end desde AWS Amplify Hosting." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="68" y="1110" width="740" height="34" as="geometry"/></mxCell><mxCell id="b76" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="38" y="1161" width="22" height="22" as="geometry"/></mxCell><mxCell id="t77" value="El usuario inicia sesión en Amazon Cognito; el token trae tenant_id y rol." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="68" y="1155" width="740" height="34" as="geometry"/></mxCell><mxCell id="b78" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="38" y="1206" width="22" height="22" as="geometry"/></mxCell><mxCell id="t79" value="Cada llamada va a la API del microservicio; el authorizer de Cognito valida el token." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="68" y="1200" width="740" height="34" as="geometry"/></mxCell><mxCell id="b80" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="38" y="1251" width="22" height="22" as="geometry"/></mxCell><mxCell id="t81" value="La Lambda escribe en su tabla DynamoDB y, en la misma transacción, el evento (registro EVENTO#).&lt;br&gt;Los archivos suben directo a S3 con URL prefirmada." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="68" y="1245" width="740" height="34" as="geometry"/></mxCell><mxCell id="b82" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="38" y="1296" width="22" height="22" as="geometry"/></mxCell><mxCell id="t83" value="DynamoDB Streams y EventBridge Pipes llevan cada evento al bus lms; Schema Registry guarda los&lt;br&gt;contratos y Archive permite reprocesar." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="68" y="1290" width="740" height="34" as="geometry"/></mxCell><mxCell id="b84" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="819" y="1116" width="22" height="22" as="geometry"/></mxCell><mxCell id="t85" value="Una regla por consumidor copia el evento a su cola SQS con DLQ; la Lambda consumidora lo procesa&lt;br&gt;una sola vez (idempotente)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="849" y="1110" width="740" height="34" as="geometry"/></mxCell><mxCell id="b86" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="819" y="1161" width="22" height="22" as="geometry"/></mxCell><mxCell id="t87" value="Las notas publicadas salen además por SNS FIFO → SQS FIFO, en orden por curso." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="849" y="1155" width="740" height="34" as="geometry"/></mxCell><mxCell id="b88" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="819" y="1206" width="22" height="22" as="geometry"/></mxCell><mxCell id="t89" value="ms-notificaciones avisa por email con Amazon SNS según las preferencias del usuario." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="849" y="1200" width="740" height="34" as="geometry"/></mxCell><mxCell id="b90" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#232F3E;strokeColor=none;fontColor=#FFFFFF;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="819" y="1251" width="22" height="22" as="geometry"/></mxCell><mxCell id="t91" value="CloudWatch y X-Ray observan todo; Serverless Framework despliega cada microservicio como un stack&lt;br&gt;de CloudFormation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="849" y="1245" width="740" height="34" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>